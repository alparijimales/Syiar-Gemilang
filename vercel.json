{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "rewrites": [
    {
      "source": "/(assets|uploads|css|js|images|icons|fonts)/(.*)",
      "destination": "/public/$1/$2"
    },
    {
      "source": "/(manifest\\.json|sw\\.js|service-worker\\.js|favicon\\.ico|favicon\\.png|robots\\.txt)",
      "destination": "/public/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}
