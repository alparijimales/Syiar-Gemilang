{
  "functions": {
    "public/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "rewrites": [
    {
      "source": "/(manifest\\.json|sw\\.js|service-worker\\.js|favicon\\.ico)",
      "destination": "/public/$1"
    },
    {
      "source": "/(assets|css|js|images|icons)/(.*)",
      "destination": "/public/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.php"
    }
  ]
}