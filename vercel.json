{
  "version": 2,
  "builds": [
    {
      "src": "public/index.php",
      "use": "vercel-php@0.7.3"
    }
  ],
  "routes": [
    {
      "src": "/(manifest\\.json|sw\\.js|service-worker\\.js|favicon\\.ico)",
      "dest": "/public/$1"
    },
    {
      "src": "/(assets|css|js|images|icons)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ]
}